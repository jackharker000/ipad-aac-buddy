# Parley env — server-only secrets. NEVER prefix with VITE_ — that would
# bundle them into the client. Read these in server functions only.
# (Exception: the VITE_FIREBASE_* vars below are the public Firebase web app
# config and are intentionally shipped to the client.)

# LLM provider keys. Default provider is Claude; OpenAI is the switchable
# alternative — set the key for whichever provider(s) you actually want.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model selection per tier — server picks the model from request.tier
# ("fast" for live suggestions / expand; "smart" for summaries, drafts,
# event prep, profile enrichment).
PARLEY_ANTHROPIC_FAST_MODEL=claude-haiku-4-5
PARLEY_ANTHROPIC_SMART_MODEL=claude-sonnet-5
PARLEY_OPENAI_FAST_MODEL=gpt-4o-mini
PARLEY_OPENAI_SMART_MODEL=gpt-4o

# STT — ElevenLabs Scribe (revisit Apple on-device after the Capacitor wrap).
ELEVENLABS_API_KEY=

# TTS — same key as STT for ElevenLabs Flash v2.5; separate key for the
# Cartesia Sonic 3 latency fallback.
CARTESIA_API_KEY=

# James's voice clone ID (ElevenLabs voice_id). Settings → People → James.
PARLEY_JAMES_VOICE_ID=

# --- Multi-tenant auth + per-user isolation (Firebase) ------------------------
# When the client config + service account are set, EVERY visitor must sign in
# and all server functions require a valid Firebase ID token. Without them,
# production builds show a "not configured" notice; dev builds run
# local-first/anonymous.
#
# Client-side Firebase web app config (safe to expose — these are public by
# design; per-user isolation is enforced by Firestore security rules, not by
# hiding these values). Firebase console → Project settings → Your apps → SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server ONLY — the Firebase Admin service account, base64-encoded JSON.
# Powers token verification, usage/cost logging, and the admin dashboard.
# Generate: Firebase console → Project settings → Service accounts → Generate
# new private key, then: base64 -i serviceAccount.json | tr -d '\n'
# Bypasses all security rules; never expose to the client.
FIREBASE_SERVICE_ACCOUNT_B64=

# Comma-separated emails that get admin-dashboard access even before their
# profiles/{uid}.role is set to 'admin' (bootstraps the first admin). The
# allow-list path additionally requires a verified email.
PARLEY_ADMIN_EMAILS=

# --- Proxy hardening (both OPTIONAL; unset == prior behavior) -----------------
# Real per-user auth above is the primary gate now; these remain as extra belts.

# Comma-separated allow-list of browser origins. When set, the API reflects a
# request's Origin only if it matches (otherwise echoes the first entry, so a
# mismatched browser is blocked by CORS). Unset => Access-Control-Allow-Origin
# stays "*" (fine for local dev / first deploy). Example:
#   PARLEY_ALLOWED_ORIGIN=https://parley.example.com,https://parley.vercel.app
PARLEY_ALLOWED_ORIGIN=

# Shared secret gating every /api/* route. When set, requests must send header
# `x-parley-token: <this value>` or get a 401. Unset => no gate.
PARLEY_CLIENT_TOKEN=
